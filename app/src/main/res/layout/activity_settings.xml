<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الإعدادات" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvLock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
        <Button android:id="@+id/btnSetPattern" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="تعيين / تغيير النمط" />
        <Button android:id="@+id/btnRemovePattern" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="إزالة النمط" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="أمر إعادة التشغيل" android:textStyle="bold" />
        <EditText android:id="@+id/etPath" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="المسار (مثل /reboot)" android:inputType="textUri" android:textDirection="ltr" />
        <EditText android:id="@+id/etMethod" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="GET أو POST" android:inputType="text" android:textDirection="ltr" />
        <EditText android:id="@+id/etBody" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="جسم الطلب (اختياري)" android:inputType="text" android:textDirection="ltr" />
        <Button android:id="@+id/btnSaveReboot" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="حفظ" />
    </LinearLayout>
</ScrollView>
