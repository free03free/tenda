<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الإعدادات" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اضبط بيانات المودم وقفل التطبيق" android:alpha="0.7" android:layout_marginBottom="20dp" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <View android:id="@+id/statusDot" android:layout_width="12dp" android:layout_height="12dp"
                    android:background="@drawable/shape_dot" />
                <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginStart="12dp"
                    android:text="لم يتم اختبار الاتصال بعد" android:textAppearance="?attr/textAppearanceBodyLarge" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="بيانات الاتصال" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:hint="عنوان IP">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etIp"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textUri" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="اسم المستخدم">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etUser"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="كلمة المرور" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPass"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPassword" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSave"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="حفظ البيانات" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTest"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginEnd="5dp" android:text="اختبار" app:icon="@drawable/ic_wifi" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnReboot"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginStart="5dp" android:text="إعادة تشغيل" app:icon="@drawable/ic_power" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="الأمان" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <TextView android:id="@+id/tvLock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:alpha="0.75" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSetPattern"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="تعيين / تغيير النمط" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRemovePattern"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إزالة النمط" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="لوحة المودم" android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swAutoLogin"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="تسجيل الدخول تلقائياً في اللوحة" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swDesktop"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="عرض نسخة سطح المكتب (ملائمة لحجم الهاتف)" />
                <TextView android:id="@+id/tvWidth" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:alpha="0.75" />
                <com.google.android.material.slider.Slider android:id="@+id/sbWidth"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:valueFrom="600" android:valueTo="1400" android:stepSize="50" android:value="900" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="أمر إعادة التشغيل" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:hint="المسار (مثل /reboot)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPath"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textUri" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="الطريقة: GET أو POST">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMethod"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="جسم الطلب (اختياري)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBody"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveReboot"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="حفظ" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="قطع الإنترنت عن كل الأجهزة" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:alpha="0.75"
                    android:text="يظهر مفتاح في الشاشة الرئيسية يرسل أحد الطلبين التاليين للمودم. اختر طلباً يقطع الإنترنت عن كل الأجهزة الحالية والجديدة (مثل فصل WAN أو وضع القائمة البيضاء الفارغة)." />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="طلب القطع (المفتاح = تشغيل)" android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="المسار (مثل /api/wan/disconnect)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOnPath"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="الطريقة: GET أو POST">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOnMethod"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="جسم الطلب (اختياري)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOnBody"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="طلب الاستعادة (المفتاح = إيقاف)" android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="المسار (مثل /api/wan/connect)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOffPath"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="الطريقة: GET أو POST">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOffMethod"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="جسم الطلب (اختياري)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOffBody"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveBlock"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="حفظ" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="الخلفية والتحديث" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swBgForce"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="العمل في الخلفية بشكل إجباري" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:alpha="0.75"
                    android:text="يُظهر إشعاراً دائماً ويُبقي التطبيق حيّاً لتعمل مدة القطع والفحص الدوري والشاشة مغلقة. على هواوي: الإعدادات ← البطارية ← تشغيل التطبيقات ← ModemControl ← إدارة يدوية، وفعّل التشغيل التلقائي والتشغيل في الخلفية. ولا تُغلق التطبيق من قائمة التطبيقات الأخيرة." />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swRefreshAfter"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="تأكيد وتحديث صفحة المودم بعد كل تشغيل/إيقاف" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:alpha="0.75"
                    android:text="يقرأ التطبيق الحالة من المودم مرة ثانية للتأكد (ويعيد الإرسال مرة واحدة إن لم تطابق)، ثم يعيد تحميل اللوحة لتظهر الإعدادات الجديدة. زر التحديث في الأعلى يفعل الشيء نفسه." />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swExpireLaunch"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="فتح التطبيق تلقائياً عند انتهاء مدة القطع" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:alpha="0.75"
                    android:text="إن كان التطبيق في الخلفية عند انتهاء المدة يفتح نفسه ثم يوقف السويتش ويستعيد الإنترنت. يتطلب إذن \"العرض فوق التطبيقات الأخرى\" (يُطلب عند التفعيل)." />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swExpireStopBg"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="إيقاف العمل في الخلفية بعد إيقاف السويتش" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:alpha="0.75"
                    android:text="بعد انتهاء المدة وإيقاف السويتش تُوقَف الخدمة والإشعار الدائم. تعود تلقائياً عند فتح التطبيق أو تشغيل قطع جديد." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="طريقة قطع الإنترنت" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <RadioGroup android:id="@+id/rgBlockMethod" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <RadioButton android:id="@+id/rbMethodParental" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="التحكم الأبوي: تبقى الأجهزة على الوايفاي بلا إنترنت" />
                    <RadioButton android:id="@+id/rbMethodMac" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="فلتر MAC (Whitelist): لا إنترنت ولا اتصال بالوايفاي" />
                </RadioGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:alpha="0.75"
                    android:text="يسري الاختيار عند تشغيل المفتاح التالي. إن كان القطع مفعّلاً فيبقى على الطريقة التي بدأ بها حتى تطفئه." />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swSweep"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="فحص الأجهزة الجديدة دورياً (التحكم الأبوي فقط)" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:hint="الفاصل بين الفحوص بالثواني (الأدنى 5)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSweepSecs"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swSweepRefresh"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="تحديث صفحة المودم عند قطع جهاز جديد في الفحص الدوري" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:alpha="0.75"
                    android:text="تُحدَّث الصفحة فقط إذا وجد الفحص جهازاً جديداً وقطعه، وليس في كل فحص." />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:alpha="0.75"
                    android:text="عند إيقاف الفحص لا يُقطع الإنترنت عن الأجهزة التي تتصل لاحقاً إلا إذا أعدت تشغيل المفتاح." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="أجهزة مستثناة من القطع" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:alpha="0.75"
                    android:text="تبقى هذه الأجهزة على الإنترنت حتى مع تفعيل المفتاح (بالتحكم الأبوي لا يُفعَّل عليها، وبفلتر MAC تدخل القائمة البيضاء). أضف هاتفك دائماً. انسخ عنوان MAC من قائمة الأجهزة في لوحة المودم." />
                <LinearLayout android:id="@+id/exemptList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="اسم الجهاز (اختياري)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etExName"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="عنوان MAC (AA:BB:CC:DD:EE:FF)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etExMac"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAddExempt"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="إضافة للمستثنين" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnDone"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp"
            android:text="حفظ والعودة للوحة المودم" app:icon="@drawable/ic_router" />
    </LinearLayout>
</ScrollView>
